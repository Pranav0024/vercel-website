# Generate unique local credentials with npm run admin:setup. Never commit real values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Development defaults to local storage in .data/. Never use this on ephemeral hosting.
# For the hosted admin, use the separate private catalogue repository and a restricted token.
# CATALOGUE_STORAGE=github
# CATALOGUE_GITHUB_REPOSITORY=Pranav0024/paniar-catalogue
# CATALOGUE_GITHUB_BRANCH=main
# CATALOGUE_GITHUB_TOKEN=
# Non-Vercel hosts only: enable after a trusted proxy sanitizes forwarded IP headers.
# ADMIN_TRUST_PROXY=true
